{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.1.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",

  "permissions": [
    "storage"
  ],

  "web_accessible_resources": [
    {
      "resources": ["popup/oauth-callback.html"],
      "matches": ["https://*/*"]
    }
  ],

  "background": {
    "scripts": ["background/service_worker.js"]
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "fediverse-actions-anyware@kotet.jp"
    }
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"]
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
